@inherits LayoutComponentBase
@inject IAuthSession AuthSession
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">
                        @context.User.Identity?.Name
                        <span class="text-muted small">(@RoleNames.Describe(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value))</span>
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync" disabled="@_loggingOut">Выйти</button>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _loggingOut;

    private async Task LogoutAsync()
    {
        _loggingOut = true;
        try
        {
            await AuthSession.LogoutAsync();
        }
        finally
        {
            _loggingOut = false;
        }
        Navigation.NavigateTo("login", replace: true);
    }
}
