@page "/courses"
@using CoreService.Contracts.Courses
@inject ICourseService CourseService

<PageTitle>Направления</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Направления</MudText>

<PagedTable @ref="_table" TItem="CourseResponse" Load="LoadAsync">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" DebounceInterval="400" Clearable="true"
                      Placeholder="Поиск по названию" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mt-0" Style="max-width: 320px;" />
    </ToolBarContent>
    <Header>
        <MudTh Style="width: 100px;">ID</MudTh>
        <MudTh>Название</MudTh>
    </Header>
    <Row Context="course">
        <MudTd DataLabel="ID">@course.Id</MudTd>
        <MudTd DataLabel="Название">@course.Name</MudTd>
    </Row>
</PagedTable>

@code {
    private PagedTable<CourseResponse> _table = null!;
    private string? _search;

    private Task<PageResult<CourseResponse>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken) =>
        CourseService.GetItemsAsync(new PageRequest<CourseFilter>
        {
            Page = page,
            PageSize = pageSize,
            Filter = new CourseFilter { Name = _search }
        }, cancellationToken);

    private async Task SearchAsync(string? value)
    {
        _search = value;
        await _table.ReloadAsync(resetPage: true);
    }
}
