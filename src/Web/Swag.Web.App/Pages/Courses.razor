@page "/courses"
@using CoreService.Contracts.Courses
@inject ICourseService CourseService

<PageTitle>Направления</PageTitle>

<h1 class="h3 mb-3">Направления</h1>

<PagedTable TItem="CourseResponse" Load="LoadAsync">
    <Header>
        <th style="width: 100px;">ID</th>
        <th>Название</th>
    </Header>
    <Row Context="course">
        <td>@course.Id</td>
        <td>@course.Name</td>
    </Row>
</PagedTable>

@code {
    private Task<PageResult<CourseResponse>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken) =>
        CourseService.GetItemsAsync(new PageRequest<CourseFilter> { Page = page, PageSize = pageSize }, cancellationToken);
}
