@page "/groups"
@using CoreService.Contracts.Groups
@inject IGroupService GroupService

<PageTitle>Группы</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Группы</MudText>

<PagedTable @ref="_table" TItem="GroupResponse" Load="LoadAsync">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" DebounceInterval="400" Clearable="true"
                      Placeholder="Поиск по названию" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mt-0" Style="max-width: 320px;" />
    </ToolBarContent>
    <Header>
        <MudTh Style="width: 100px;">ID</MudTh>
        <MudTh>Название</MudTh>
    </Header>
    <Row Context="group">
        <MudTd DataLabel="ID">@group.Id</MudTd>
        <MudTd DataLabel="Название">@group.Name</MudTd>
    </Row>
</PagedTable>

@code {
    private PagedTable<GroupResponse> _table = null!;
    private string? _search;

    private Task<PageResult<GroupResponse>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken) =>
        GroupService.GetItemsAsync(new PageRequest<GroupFilter>
        {
            Page = page,
            PageSize = pageSize,
            Filter = new GroupFilter { Name = _search }
        }, cancellationToken);

    private async Task SearchAsync(string? value)
    {
        _search = value;
        await _table.ReloadAsync(resetPage: true);
    }
}
