@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject IAuthSession AuthSession
@inject NavigationManager Navigation

<PageTitle>Вход</PageTitle>

<MudCard Elevation="3" Style="width: 100%; max-width: 400px;">
    <MudCardContent Class="pa-6">
        <div class="d-flex flex-column align-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="mt-2">Вход</MudText>
        </div>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="login">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_model.Login" For="@(() => _model.Login)" Label="Логин"
                          Variant="Variant.Outlined" AutoFocus="true" Class="mb-3" />

            <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)" Label="Пароль"
                          Variant="Variant.Outlined" InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="Показать пароль" OnAdornmentClick="() => _showPassword = !_showPassword"
                          Class="mb-3" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Disabled="_submitting">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Войти
            </MudButton>
        </EditForm>
    </MudCardContent>
</MudCard>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private readonly LoginModel _model = new();
    private bool _submitting;
    private bool _showPassword;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(SafeReturnUrl, replace: true);
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            _error = await AuthSession.LoginAsync(_model.Login, _model.Password);
            if (_error is null)
                Navigation.NavigateTo(SafeReturnUrl, replace: true);
        }
        catch (HttpRequestException)
        {
            _error = "Сервер авторизации недоступен";
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>Возвращаем только на относительный адрес внутри приложения, не на чужой сайт.</summary>
    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && Uri.TryCreate(ReturnUrl, UriKind.Relative, out _) && !ReturnUrl.StartsWith("//")
            && !ReturnUrl.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            ? ReturnUrl
            : "";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Введите логин")]
        public string Login { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = "";
    }
}
