@page "/teachers"
@using CoreService.Contracts.Teachers
@inject ITeacherService TeacherService

<PageTitle>Преподаватели</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Преподаватели</MudText>

<PagedTable @ref="_table" TItem="TeacherResponse" Load="LoadAsync">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" DebounceInterval="400" Clearable="true"
                      Placeholder="Поиск по имени" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mt-0" Style="max-width: 320px;" />
    </ToolBarContent>
    <Header>
        <MudTh Style="width: 100px;">ID</MudTh>
        <MudTh>Имя</MudTh>
    </Header>
    <Row Context="teacher">
        <MudTd DataLabel="ID">@teacher.Id</MudTd>
        <MudTd DataLabel="Имя">@teacher.Name</MudTd>
    </Row>
</PagedTable>

@code {
    private PagedTable<TeacherResponse> _table = null!;
    private string? _search;

    private Task<PageResult<TeacherResponse>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken) =>
        TeacherService.GetItemsAsync(new PageRequest<TeacherFilter>
        {
            Page = page,
            PageSize = pageSize,
            Filter = new TeacherFilter { Name = _search }
        }, cancellationToken);

    private async Task SearchAsync(string? value)
    {
        _search = value;
        await _table.ReloadAsync(resetPage: true);
    }
}
