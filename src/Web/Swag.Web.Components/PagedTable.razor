@typeparam TItem
@using SharedKernel.Contracts.Pagination
@using Swag.Web.Api

@* Таблица с серверной пагинацией на MudTable: номер страницы и размер приходят из пейджера *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">
        <div class="d-flex align-center gap-2">
            <span>@_error</span>
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="() => ReloadAsync()">Повторить</MudButton>
        </div>
    </MudAlert>
}

<MudTable @ref="_table" T="TItem" ServerData="LoadServerDataAsync" RowsPerPage="PageSize"
          Hover="true" Striped="true" Elevation="1" LoadingProgressColor="Color.Primary"
          ToolBarContent="ToolBarContent" HeaderContent="Header" RowTemplate="Row">
    <NoRecordsContent>
        <MudText Color="Color.Secondary">Нет данных</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Color="Color.Secondary">Загрузка…</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="PageSizes" RowsPerPageString="На странице:"
                       InfoFormat="{first_item}–{last_item} из {all_items}" />
    </PagerContent>
</MudTable>

@code {
    private static readonly int[] PageSizes = [10, 20, 50];

    /// <summary>Загрузка страницы: номер с 1, размер, токен отмены.</summary>
    [Parameter, EditorRequired] public Func<int, int, CancellationToken, Task<PageResult<TItem>>> Load { get; set; } = null!;
    /// <summary>Заголовки колонок — <c>MudTh</c>.</summary>
    [Parameter, EditorRequired] public RenderFragment Header { get; set; } = null!;
    /// <summary>Ячейки строки — <c>MudTd</c>.</summary>
    [Parameter, EditorRequired] public RenderFragment<TItem> Row { get; set; } = null!;
    /// <summary>Панель над таблицей: поиск, фильтры, кнопки.</summary>
    [Parameter] public RenderFragment? ToolBarContent { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;

    private MudTable<TItem> _table = null!;
    private string? _error;

    /// <summary>
    /// Перечитать данные. <paramref name="resetPage"/> — вернуться на первую страницу,
    /// например после смены фильтра: на текущей странице новой выборки может уже не быть.
    /// </summary>
    public async Task ReloadAsync(bool resetPage = false)
    {
        if (resetPage && _table.CurrentPage != 0)
            _table.NavigateTo(0);
        await _table.ReloadServerData();
    }

    private async Task<TableData<TItem>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var result = await Load(state.Page + 1, state.PageSize, cancellationToken);
            SetError(null);
            return new TableData<TItem> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // MudTable отменяет предыдущую загрузку при быстром переключении — это не ошибка
            return new TableData<TItem> { Items = [], TotalItems = 0 };
        }
        catch (Exception ex)
        {
            SetError(ApiError.Describe(ex));
            return new TableData<TItem> { Items = [], TotalItems = 0 };
        }
    }

    private void SetError(string? error)
    {
        if (_error == error)
            return;
        _error = error;
        StateHasChanged();
    }
}
