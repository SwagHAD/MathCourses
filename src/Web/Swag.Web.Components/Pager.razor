@* Номера страниц: первая, последняя и окно вокруг текущей, остальное — многоточием *@
@if (TotalPages > 1)
{
    <nav aria-label="Страницы">
        <ul class="pagination mb-0">
            <li class="page-item @(Page <= 1 ? "disabled" : null)">
                <button class="page-link" @onclick="() => GoTo(Page - 1)" aria-label="Предыдущая">&laquo;</button>
            </li>
            @foreach (var item in BuildItems())
            {
                if (item is null)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else
                {
                    var number = item.Value;
                    <li class="page-item @(number == Page ? "active" : null)">
                        <button class="page-link" @onclick="() => GoTo(number)">@number</button>
                    </li>
                }
            }
            <li class="page-item @(Page >= TotalPages ? "disabled" : null)">
                <button class="page-link" @onclick="() => GoTo(Page + 1)" aria-label="Следующая">&raquo;</button>
            </li>
        </ul>
    </nav>
}

@code {
    private const int Window = 2;

    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private async Task GoTo(int page)
    {
        if (page < 1 || page > TotalPages || page == Page)
            return;
        await PageChanged.InvokeAsync(page);
    }

    private IEnumerable<int?> BuildItems()
    {
        var from = Math.Max(2, Page - Window);
        var to = Math.Min(TotalPages - 1, Page + Window);

        yield return 1;
        if (from > 2)
            yield return null;
        for (var i = from; i <= to; i++)
            yield return i;
        if (to < TotalPages - 1)
            yield return null;
        yield return TotalPages;
    }
}
